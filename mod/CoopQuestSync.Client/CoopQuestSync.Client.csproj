<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>
    <ItemGroup>
        <PackageReference Include="ReadyM.SDK.Oblivion.Client" Version="1.1.0" />
    </ItemGroup>
    <ItemGroup>
        <ProjectReference Include="..\CoopQuestSync.Common\CoopQuestSync.Common.csproj" />
    </ItemGroup>
    <ItemGroup>
        <None Update="web\**\*">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
        <!-- The UE4SS add-on travels with the client mod; ConsoleBridge installs it in the game's Mods folder. -->
        <None Include="..\..\ui\CoopQuestSyncUI\**\*" Link="addon\CoopQuestSyncUI\%(RecursiveDir)%(Filename)%(Extension)">
            <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        </None>
    </ItemGroup>
    <ItemGroup>
        <Compile Include="..\Shared\GameFiles.cs" Link="GameFiles.cs" />
    </ItemGroup>
</Project>
